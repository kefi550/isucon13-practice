[mysqld]
# ISUCON向けチューニング
# 参考: メモリ 3.7GB / vCPU 2 の環境
innodb_buffer_pool_size        = 1G
innodb_flush_log_at_trx_commit = 2
innodb_flush_method            = O_DIRECT
innodb_redo_log_capacity       = 256M
sync_binlog                    = 0
disable_log_bin
max_connections                = 500
table_open_cache               = 4000
